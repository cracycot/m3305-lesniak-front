{{#> layout}}
<section aria-labelledby="create-title">
    <h1 id="create-title">Добавить исторический объект</h1>
    <p>Заполните форму, чтобы добавить новый объект в коллекцию.</p>

    <form method="POST" action="/objects" class="create-form">
        <div class="form-group">
            <label for="title">Название объекта <span aria-hidden="true">*</span></label>
            <input type="text" id="title" name="title" required placeholder="Например: Невский проспект" />
        </div>

        <div class="form-group">
            <label for="year">Год основания <span aria-hidden="true">*</span></label>
            <input type="number" id="year" name="year" required min="1000" max="2100"
                placeholder="Например: 1710" />
        </div>

        {{#if categories.length}}
        <div class="form-group">
            <label for="categoryId">Категория</label>
            <select id="categoryId" name="categoryId">
                <option value="">— без категории —</option>
                {{#each categories}}
                <option value="{{id}}">{{name}}</option>
                {{/each}}
            </select>
        </div>
        {{/if}}

        <div class="form-group">
            <label for="description">Описание</label>
            <textarea id="description" name="description" rows="5"
                placeholder="Краткая историческая справка об объекте..."></textarea>
        </div>

        <div class="form-group">
            <label for="imageUrl">URL изображения</label>
            <input type="url" id="imageUrl" name="imageUrl" placeholder="https://example.com/image.jpg" />
        </div>

        <div class="form-group">
            <label for="imageAlt">Alt-текст изображения</label>
            <input type="text" id="imageAlt" name="imageAlt" placeholder="Описание изображения" />
        </div>

        <div class="form-group">
            <label for="imageCaption">Подпись к изображению</label>
            <input type="text" id="imageCaption" name="imageCaption" placeholder="Краткая подпись под фото" />
        </div>

        <div class="form-group">
            <label for="facts">Интересные факты</label>
            <textarea id="facts" name="facts" rows="4"
                placeholder="Каждый факт — с новой строки&#10;Например: Здание было построено в 1710 году&#10;Реставрация заняла 10 лет"></textarea>
            <small>Каждый факт — с новой строки</small>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Добавить объект</button>
            <a href="/objects" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</section>
{{/layout}}
