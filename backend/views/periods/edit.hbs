{{#> layout}}
<section aria-labelledby="edit-period-title">
    <h1 id="edit-period-title">Редактировать период</h1>

    {{#if period}}
    <form method="POST" action="/periods/{{period.id}}" class="create-form">
        <div class="form-group">
            <label for="name">Название <span aria-hidden="true">*</span></label>
            <input type="text" id="name" name="name" required value="{{period.name}}" />
        </div>

        <div class="form-group">
            <label for="startYear">Начальный год</label>
            <input type="number" id="startYear" name="startYear" min="1700" max="2100"
                value="{{period.startYear}}" />
        </div>

        <div class="form-group">
            <label for="endYear">Конечный год</label>
            <input type="number" id="endYear" name="endYear" min="1700" max="2100"
                value="{{period.endYear}}" />
        </div>

        <div class="form-group">
            <label for="description">Описание</label>
            <textarea id="description" name="description" rows="4">{{period.description}}</textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a href="/periods" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
    {{else}}
    <p>Период не найден.</p>
    {{/if}}
</section>
{{/layout}}
