{{#> layout}}
<section aria-labelledby="create-period-title">
    <h1 id="create-period-title">Добавить исторический период</h1>

    <form method="POST" action="/periods" class="create-form">
        <div class="form-group">
            <label for="name">Название <span aria-hidden="true">*</span></label>
            <input type="text" id="name" name="name" required
                placeholder="Например: До блокады" />
        </div>

        <div class="form-group">
            <label for="startYear">Начальный год</label>
            <input type="number" id="startYear" name="startYear" min="1700" max="2100"
                placeholder="Например: 1941" />
        </div>

        <div class="form-group">
            <label for="endYear">Конечный год</label>
            <input type="number" id="endYear" name="endYear" min="1700" max="2100"
                placeholder="Например: 1944" />
        </div>

        <div class="form-group">
            <label for="description">Описание</label>
            <textarea id="description" name="description" rows="4"
                placeholder="Краткое описание периода"></textarea>
        </div>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary">Создать период</button>
            <a href="/periods" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</section>
{{/layout}}
