        E-mail: <a href="mailto:team@lenvictory.example">team@lenvictory.example</a><br />
        Телефон: <a href="tel:+78120000000">+7 (812) 000-00-00</a><br />
        Санкт‑Петербург, Невский проспект, 1
    </address>
</section>
{{/layout}}
