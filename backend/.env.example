# Copy this file to .env and fill in your values

# Server port (optional, default: 3080)
PORT=3080

# Node environment: development | production
NODE_ENV=development

# PostgreSQL connection string
# Local example:   postgres://user:password@localhost:5432/leningrad
# Render (internal): shown on the Render database dashboard
# Aiven example:   postgres://user:password@host.aivencloud.com:PORT/defaultdb?sslmode=require
DATABASE_URL=postgres://postgres:password@localhost:5432/leningrad

# ── SuperTokens (ЛР7: аутентификация) ───────────────────────────────────────
# Получить на https://supertokens.com → Managed Service → Create App
# Для локального запуска можно добавить supertokens-core в docker-compose.yml
# и использовать: SUPERTOKENS_CONNECTION_URI=http://localhost:3567
# Если переменная не задана — модуль запускается в mock-режиме (auth отключён)
SUPERTOKENS_CONNECTION_URI=https://try.supertokens.com
SUPERTOKENS_API_KEY=
SUPERTOKENS_APP_NAME=Leningrad After Victory
SUPERTOKENS_API_DOMAIN=http://localhost:3080
SUPERTOKENS_WEBSITE_DOMAIN=http://localhost:3080

# CORS: разрешённые origins (через запятую), по умолчанию разрешены все
# CORS_ORIGIN=http://localhost:3000,http://localhost:3080

# ── Yandex Object Storage (ЛР6: загрузка файлов в S3) ───────────────────────
# 1. Создайте бакет в https://console.yandex.cloud/ → Object Storage
# 2. Создайте сервисный аккаунт с ролью storage.editor (Folder → Service accounts)
# 3. Для этого сервисного аккаунта создайте "Статический ключ доступа"
#    (получите Access Key ID и Secret Key — secret показывается ровно один раз)
# 4. Если переменные не заданы — загрузка файлов возвращает 503
YC_ACCESS_KEY_ID=
YC_SECRET_ACCESS_KEY=
YC_BUCKET=
YC_ENDPOINT=https://storage.yandexcloud.net
YC_REGION=ru-central1
